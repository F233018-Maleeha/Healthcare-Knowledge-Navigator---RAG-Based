# Copy to .env and fill in real values before running docker-compose up

ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=change-me

# --- LLM (generation) ---
# Recommended: groq for generation. Groq's custom LPU hardware runs
# open models (Llama 3.3 70B, etc) at 300+ tokens/sec with sub-second
# latency - dramatically faster and more consistently available than
# Gemini's free tier, which was cut significantly in late 2025 and is
# prone to slow/overloaded responses. Groq has no embeddings API, so
# pair it with gemini or local_stub for embeddings below.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Embeddings ---
# local_stub = deterministic hash embedder, no network, dev/test only.
# gemini = genuinely free tier, real semantic embeddings (text-embedding-004).
# openai/voyage/cohere require their own billing/API keys.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=
EMBEDDING_DIM=768

# --- Vector store ---
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hkn_chunks

# --- Postgres ---
POSTGRES_DSN=postgresql+asyncpg://hkn:hkn@localhost:5432/hkn

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
